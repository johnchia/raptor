#!/bin/sh
# S31raptor -- Raptor Streaming System init script

CONF=/etc/raptor.conf
RUNDIR=/var/run/rss
SHMDIR=/dev/shm

# Read a boolean from raptor.conf: config_bool <section> <key> <default>
config_bool() {
	val=$(raptorctl config get "$1" "$2" 2>/dev/null | tr -d '\r\n')
	val=$(printf '%s' "${val:-$3}" | tr 'A-Z' 'a-z')
	case "$val" in
		true | yes | 1 | on) return 0 ;;
		*) return 1 ;;
	esac
}

# Start a daemon, report status: start_daemon <name> [env_prefix]
start_daemon() {
	name=$1
	shift
	if [ ! -x "/usr/bin/$name" ]; then
		printf "  %-4s skipped (not installed)\n" "$name"
		return
	fi
	if ! daemon_enabled "$name"; then
		printf "  %-4s disabled\n" "$name"
		return
	fi
	if [ $# -gt 0 ]; then
		env "$@" start-stop-daemon -S -b -x /usr/bin/$name -- -c "$CONF"
	else
		start-stop-daemon -S -b -x /usr/bin/$name -- -c "$CONF"
	fi
	if [ $? -eq 0 ]; then
		printf "  %-4s started\n" "$name"
	else
		printf "  %-4s FAILED\n" "$name"
	fi
}

# Map daemon name to config section and default enabled state
daemon_section() {
	case $1 in
		rvd) echo "sensor" ;;
		rsd) echo "rtsp" ;;
		rsd-555) echo "rtsp" ;;
		rad) echo "audio" ;;
		rhd) echo "http" ;;
		rod) echo "osd" ;;
		ric) echo "ircut" ;;
		rmr) echo "recording" ;;
		rmd) echo "motion" ;;
		rwd) echo "webrtc" ;;
		rwc) echo "webcam" ;;
		rsp) echo "push" ;;
		rsr) echo "srt" ;;
		rmq) echo "mqtt" ;;
		*) echo "$1" ;;
	esac
}

daemon_default_enabled() {
	case $1 in
		rmr | rmd | rwc | rsp | rsr | rsd-555 | rmq) echo "false" ;;
		*) echo "true" ;;
	esac
}

# Should a daemon start? Its own section decides, normally. rmr hosts two
# features and runs fine with recording off ("timelapse only -- recording
# stays off"), so a timelapse-only config must also bring it up: gating on
# [recording] alone left [timelapse] enabled = true written and honoured,
# but nothing ever started the daemon that reads it.
daemon_enabled() {
	config_bool "$(daemon_section $1)" "enabled" "$(daemon_default_enabled $1)" && return 0
	case $1 in
		rmr) config_bool "timelapse" "enabled" "false" ;;
		*) return 1 ;;
	esac
}

start() {
	echo "Starting Raptor Streaming System..."
	mkdir -p "$RUNDIR"

	# RVD must start first -- it creates SHM rings
	start-stop-daemon -S -b -x /usr/bin/rvd -- -c "$CONF"
	printf "  %-4s started\n" "rvd"

	# Wait for main ring (up to 5 seconds)
	i=0
	while [ $i -lt 50 ] && [ ! -e ${SHMDIR}/rss_ring_main ]; do
		usleep 100000
		i=$((i + 1))
	done

	if [ ! -e ${SHMDIR}/rss_ring_main ]; then
		printf "  rvd  FAILED (no ring after 5s)\n"
		exit 1
	fi

	# Audio: preload libimp-nodbg if available to avoid competing IMP debug thread
	RAD_ENV=""
	[ -f /usr/lib/libimp-nodbg.so ] && RAD_ENV="LD_PRELOAD=/usr/lib/libimp-nodbg.so"
	start_daemon rad $RAD_ENV

	# Core daemons
	start_daemon rod
	start_daemon rsd
	start_daemon rsd-555
	start_daemon rhd
	start_daemon ric
	start_daemon rmr
	start_daemon rmd
	start_daemon rwd
	start_daemon rsp
	start_daemon rsr

	# rcd owns the configuration: it validates every edit, writes
	# raptor.conf, and sequences the restarts that some edits need. Started
	# before rmq because rmq is one of its clients, and after the daemons it
	# manages so its first state answer describes a camera that is already up.
	start_daemon rcd

	# rmq last: it polls the other daemons through rcd and needs both rcd
	# and everything it reports on already running.
	start_daemon rmq

	echo "Done."
}

stop_daemon() {
	pid=$(pidof "$1") || return
	kill "$pid" 2>/dev/null
	i=0
	while [ $i -lt 30 ] && kill -0 "$pid" 2>/dev/null; do
		sleep 0.1
		i=$((i + 1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		kill -9 "$pid" 2>/dev/null
		printf "  %-4s killed\n" "$1"
	else
		printf "  %-4s stopped\n" "$1"
	fi
}

stop() {
	echo "Stopping Raptor Streaming System..."

	# Stop consumers first, then producer (RVD) last. rmq and rcd lead: both
	# issue control commands to the rest, so stopping them first keeps them
	# from restarting a daemon mid-shutdown.
	#
	# Every daemon start() starts has to appear here, because the cleanup
	# below deletes the whole run directory. One left out survives the stop
	# with its socket unlinked underneath it and never rebinds -- start()
	# then finds it running and skips it, so it stays unreachable until the
	# next reboot. rcd omitted here is what silently killed the web console.
	for d in rmq rcd rsr rsp rwd rmd rmr ric rhd rsd rsd-555 rod rad rvd; do
		stop_daemon $d
	done

	# Clean up runtime files
	rm -f "$RUNDIR"/*.pid "$RUNDIR"/*.sock
	rm -f ${SHMDIR}/rss_ring_* ${SHMDIR}/rss_osd_*

	echo "Done."
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
