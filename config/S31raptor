#!/bin/sh
# S31raptor -- Raptor Streaming System init script

CONF=/etc/raptor.conf
RUNDIR=/var/run/rss

case "$1" in
	start)
		echo "Starting Raptor..."
		mkdir -p "$RUNDIR"

		# RVD must start first (creates SHM rings)
		start-stop-daemon -S -b -x /usr/bin/rvd -- -c "$CONF"

		# Wait for main ring (up to 5 seconds)
		i=0
		while [ $i -lt 50 ] && [ ! -e /dev/shm/rss_ring_main ]; do
			usleep 100000
			i=$((i + 1))
		done

		if [ ! -e /dev/shm/rss_ring_main ]; then
			echo "RVD failed to create ring buffer"
			exit 1
		fi

		# Start consumers and support daemons
		start-stop-daemon -S -b -x /usr/bin/rad -- -c "$CONF"
		start-stop-daemon -S -b -x /usr/bin/rod -- -c "$CONF"
		start-stop-daemon -S -b -x /usr/bin/rsd -- -c "$CONF"
		start-stop-daemon -S -b -x /usr/bin/ric -- -c "$CONF"

		# rhd serves snapshots and MJPEG off the same rings, so it needs rvd up
		# and nothing else. Guarded like rmq below: the HTTP daemon is not in
		# every image, and one built without it should not report a failed start
		# on every boot.
		if [ -x /usr/bin/rhd ]; then
			start-stop-daemon -S -b -x /usr/bin/rhd -- -c "$CONF"
		fi

		# rmq last: it polls the other daemons over their control sockets and
		# restarts them for config keys that only apply at bring-up, so it wants
		# everything it talks to already up. Guarded because the MQTT bridge is
		# not in every image.
		if [ -x /usr/bin/rmq ]; then
			start-stop-daemon -S -b -x /usr/bin/rmq -- -c "$CONF"
		fi

		echo "Raptor started"
		;;

	stop)
		echo "Stopping Raptor..."

		# Stop consumers first, then producers, then HAL owner. rmq leads: it
		# issues control commands to the rest, so stopping it first keeps it from
		# restarting a daemon mid-shutdown.
		for d in rmq rhd ric rsd rod rad rvd; do
			start-stop-daemon -K -x /usr/bin/$d 2>/dev/null
		done

		# Clean up runtime files
		rm -f "$RUNDIR"/*.pid "$RUNDIR"/*.sock
		rm -f /dev/shm/rss_ring_* /dev/shm/rss_osd_*

		echo "Raptor stopped"
		;;

	restart)
		"$0" stop
		sleep 1
		"$0" start
		;;

	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
